# ============================================================
# BOND Environment Variables — Example File
# Copy to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.
# ============================================================

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=BOND
NODE_ENV=development

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://username:password@localhost:5432/bond
# Use a connection pooler URL if using PgBouncer/Supabase pooling:
# DATABASE_URL_UNPOOLED=postgresql://username:password@localhost:5432/bond

# --- Session / JWT ---
# Generate with: openssl rand -base64 64
SESSION_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET_AT_LEAST_64_CHARS
JWT_SECRET=REPLACE_WITH_ANOTHER_SECURE_RANDOM_SECRET_AT_LEAST_64_CHARS
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# --- Iron Session ---
IRON_SESSION_PASSWORD=REPLACE_WITH_SECURE_RANDOM_PASSWORD_AT_LEAST_32_CHARS

# --- Email (SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@yourplatform.com
SMTP_PASS=your_smtp_password
EMAIL_FROM=BOND <noreply@yourplatform.com>

# --- WalletConnect / Reown AppKit ---
# Register at https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID

# --- Blockchain RPC Providers ---
# Ethereum Sepolia Testnet (development/testing)
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
# Ethereum Mainnet — DISABLED until production security review complete
# NEXT_PUBLIC_MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY

# Polygon Mumbai Testnet
NEXT_PUBLIC_POLYGON_MUMBAI_RPC_URL=https://polygon-mumbai.infura.io/v3/YOUR_INFURA_KEY

# --- Infura (server-side RPC — keep SECRET) ---
INFURA_API_KEY=YOUR_INFURA_API_KEY
ALCHEMY_API_KEY=YOUR_ALCHEMY_API_KEY

# --- SIWE Nonce ---
# Domain used for SIWE messages — must match your deployment domain
NEXT_PUBLIC_SIWE_DOMAIN=localhost:3000

# --- 2FA ---
TOTP_ISSUER=BOND

# --- Rate Limiting ---
RATE_LIMIT_REDIS_URL=redis://localhost:6379
# Leave blank to use in-memory rate limiting (development only):
# RATE_LIMIT_REDIS_URL=

# --- Admin ---
# Initial admin email (set before first run; change after setup)
ADMIN_EMAIL=admin@yourplatform.com

# --- Security ---
# HTTPS enforced in production — set to true in prod
ENFORCE_HTTPS=false

# --- Production Networks (DISABLED by default) ---
# Uncomment ONLY after completing full security review, legal compliance,
# and independent security audit.
# ENABLE_MAINNET=false
# ENABLE_POLYGON_MAINNET=false
